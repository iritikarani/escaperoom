# Copy this file to .env and fill in real values. Never commit .env.

# Token from @BotFather (looks like 123456789:AA...)
TELEGRAM_BOT_TOKEN=your-bot-token-here

# SQLite database location. Put it on PERSISTENT storage in production.
DATABASE_PATH=data/escape_room.db

# Optional overrides
# PUZZLES_PATH=puzzles/puzzles.json
# ASSETS_DIR=assets/puzzle_images
# LOBBY_TTL_HOURS=24
# ANSWER_RATE_LIMIT_PER_MINUTE=15
# JOIN_FAILURE_LIMIT=10
# LOG_LEVEL=INFO

# Webhook mode (leave WEBHOOK_URL empty to use long polling - the default)
# WEBHOOK_URL=https://your-domain.example.com
# WEBHOOK_SECRET=a-long-random-string
# PORT=8443

# Outbound proxy for Telegram API calls (PythonAnywhere free plan only)
# TELEGRAM_PROXY_URL=http://proxy.server:3128

# Mini App (visual room screen) - webhook hosting only; pythonanywhere_setup.py sets these
# WEBAPP_URL=https://yourname.pythonanywhere.com/app
# MINIAPP_LINK=https://t.me/YourBot/room   (from @BotFather /newapp, enables the button in groups)

# Shown on the /privacy page (https://yourname.pythonanywhere.com/privacy) for data deletion requests
# PRIVACY_CONTACT=@yourname
